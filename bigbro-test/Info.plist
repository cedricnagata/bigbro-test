<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_bigbro._tcp</string>
	</array>
	<!-- Declares export compliance in the build itself, so App Store Connect stops
	     asking per upload and a TestFlight build reaches testers without anyone
	     answering a form. False is the accurate answer here, not a convenience:
	     the app opens a plain TCP connection to the Mac (NWConnection using .tcp,
	     not .tls) and neither it nor BigBroKit references CryptoKit, CommonCrypto,
	     Security, or any https:// endpoint. Re-check this if the protocol ever
	     gains TLS or the app starts talking to a web service. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
